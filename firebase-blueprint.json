{
  "entities": {
    "user": {
      "title": "UserProfile",
      "description": "Perfil e credenciais funcionais sincronizadas do servidor policial",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Identificador único do usuário no Firebase Auth",
          "minLength": 1,
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "description": "Nome de usuário exclusivo para login e identificação",
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "description": "E-mail de acesso da conta",
          "maxLength": 150
        },
        "displayName": {
          "type": "string",
          "description": "Nome completo ou identificação funcional do policial",
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "description": "URL da foto ou avatar",
          "maxLength": 500
        },
        "cargo": {
          "type": "string",
          "description": "Cargo policial (Delegado, Inspetor, Escrivão, etc.)",
          "maxLength": 100
        },
        "registrationNumber": {
          "type": "string",
          "description": "Matrícula funcional PCCE",
          "maxLength": 50
        },
        "institutionalEmail": {
          "type": "string",
          "description": "E-mail institucional (@policiacivil.ce.gov.br)",
          "maxLength": 150
        },
        "unitName": {
          "type": "string",
          "description": "Lotação / Unidade Policial",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "description": "Telefone de contato ou WhatsApp da delegacia",
          "maxLength": 50
        },
        "department": {
          "type": "string",
          "description": "Cartório, Plantão ou Setor responsável",
          "maxLength": 100
        },
        "authProvider": {
          "type": "string",
          "description": "Provedor de autenticação (password, google, anonymous)",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp Unix da última sincronização de perfil"
        }
      },
      "required": ["uid"]
    },
    "oitiva": {
      "title": "Oitiva",
      "description": "Registro de audiência/oitiva policial na Delegacia de Maracanaú",
      "type": "object",
      "properties": {
        "personName": {
          "type": "string",
          "description": "Nome completo da pessoa a ser ouvida",
          "minLength": 1,
          "maxLength": 300
        },
        "date": {
          "type": "string",
          "description": "Data da oitiva formato YYYY-MM-DD",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "time": {
          "type": "string",
          "description": "Horário no formato HH:mm",
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "procedureNumber": {
          "type": "string",
          "description": "Número do procedimento policial",
          "maxLength": 100
        },
        "procedureType": {
          "type": "string",
          "description": "Tipo de procedimento policial",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Papel da pessoa (Testemunha, Vítima, Investigado, Declarante, etc.)",
          "maxLength": 100
        },
        "cpf": {
          "type": "string",
          "description": "CPF do depoente",
          "maxLength": 30
        },
        "rg": {
          "type": "string",
          "description": "RG do depoente",
          "maxLength": 50
        },
        "phone": {
          "type": "string",
          "description": "Telefone de contato",
          "maxLength": 50
        },
        "email": {
          "type": "string",
          "description": "E-mail de contato",
          "maxLength": 150
        },
        "address": {
          "type": "string",
          "description": "Endereço residencial ou comercial",
          "maxLength": 300
        },
        "neighborhood": {
          "type": "string",
          "description": "Bairro",
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "description": "Cidade e estado",
          "maxLength": 100
        },
        "officerName": {
          "type": "string",
          "description": "Autoridade Policial Delegado(a)",
          "maxLength": 150
        },
        "clerkName": {
          "type": "string",
          "description": "Escrivão(ã) ou Inspetor responsável",
          "maxLength": 150
        },
        "modality": {
          "type": "string",
          "description": "Presencial, Videoconferência ou Híbrida",
          "maxLength": 50
        },
        "locationOrLink": {
          "type": "string",
          "description": "Sala ou Link do Google Meet",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Status da oitiva",
          "enum": ["Agendada", "Realizada", "Remarcada", "Cancelada", "Não Compareceu"]
        },
        "notes": {
          "type": "string",
          "description": "Observações e anotações do cartório",
          "maxLength": 2000
        },
        "intimationSent": {
          "type": "boolean",
          "description": "Flag de intimação expedida ou entregue"
        },
        "googleCalendarEventId": {
          "type": "string",
          "description": "ID do evento no Google Calendar",
          "maxLength": 255
        },
        "googleDriveDocId": {
          "type": "string",
          "description": "ID do documento do termo no Google Drive",
          "maxLength": 255
        },
        "googleDriveDocUrl": {
          "type": "string",
          "description": "URL pública ou interna do termo no Google Drive",
          "maxLength": 500
        },
        "lastGmailSentAt": {
          "type": "number",
          "description": "Timestamp Unix da última intimação enviada por e-mail"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp Unix de criação"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp Unix de última atualização"
        },
        "createdBy": {
          "type": "string",
          "description": "Identificador do usuário ou cartório que criou",
          "maxLength": 150
        },
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID do usuário proprietário da oitiva",
          "maxLength": 128
        }
      },
      "required": ["personName", "status", "createdAt", "updatedAt"]
    },
    "delegado": {
      "title": "DelegadoInfo",
      "description": "Autoridade Policial / Delegado(a) de Polícia Civil cadastrado no catálogo unificado",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único do delegado",
          "maxLength": 100
        },
        "nome": {
          "type": "string",
          "description": "Nome completo da autoridade policial",
          "minLength": 1,
          "maxLength": 150
        },
        "cargo": {
          "type": "string",
          "description": "Cargo ou função (Ex: Delegado de Polícia Civil)",
          "maxLength": 100
        },
        "matricula": {
          "type": "string",
          "description": "Matrícula funcional",
          "maxLength": 50
        },
        "delegacia": {
          "type": "string",
          "description": "Lotação / Delegacia Oficial",
          "maxLength": 150
        },
        "municipio": {
          "type": "string",
          "description": "Município e UF",
          "maxLength": 100
        },
        "portariaOuObs": {
          "type": "string",
          "description": "Portaria de lotação ou observações adicionais",
          "maxLength": 500
        },
        "fotoUrl": {
          "type": "string",
          "description": "URL da foto institucional",
          "maxLength": 500
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp Unix de cadastro"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp Unix de última atualização"
        }
      },
      "required": ["id", "nome"]
    },
    "specialDate": {
      "title": "CalendarSpecialDate",
      "description": "Feriados, pontos facultativos e demarcações de fins de semana aplicados globalmente a todos os usuários",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único da data especial"
        },
        "title": {
          "type": "string",
          "description": "Nome do feriado ou demarcação (Ex: Feriado da Independência, Domingo)",
          "minLength": 1,
          "maxLength": 150
        },
        "date": {
          "type": "string",
          "description": "Data no formato YYYY-MM-DD (opcional se for recorrente anual ou dia da semana)"
        },
        "dayOfWeek": {
          "type": "number",
          "description": "Dia da semana (0 para Domingo, 6 para Sábado)"
        },
        "type": {
          "type": "string",
          "description": "Tipo de demarcação",
          "enum": ["feriado_nacional", "feriado_estadual", "feriado_municipal", "ponto_facultativo", "fim_de_semana", "custom"]
        },
        "color": {
          "type": "string",
          "description": "Código de cor hex ou classe de estilo"
        },
        "description": {
          "type": "string",
          "description": "Descrição ou fundamentação legal da data"
        },
        "isRecurring": {
          "type": "boolean",
          "description": "Se a data se repete todos os anos"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp Unix de criação"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp Unix de atualização"
        },
        "createdBy": {
          "type": "string",
          "description": "E-mail ou UID do administrador que cadastrou"
        }
      },
      "required": ["id", "title", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "Perfis e credenciais funcionais persistidas para sincronização entre dispositivos"
    },
    "/users/{userId}/oitivas/{oitivaId}": {
      "schema": "oitiva",
      "description": "Coleção isolada de oitivas e agendamentos policiais de cada usuário"
    },
    "/oitivas/{oitivaId}": {
      "schema": "oitiva",
      "description": "Coleção de oitivas e agendamentos policiais sincronizada em tempo real"
    },
    "/delegados/{delegadoId}": {
      "schema": "delegado",
      "description": "Catálogo unificado de Delegados de Polícia Civil compartilhado entre todos os usuários"
    },
    "/special_dates/{dateId}": {
      "schema": "specialDate",
      "description": "Demarcação de feriados oficiais e fins de semana sincronizada para todos os usuários"
    },
    "/system_config/{configId}": {
      "schema": "object",
      "description": "Configurações globais do sistema e catálogo unificado"
    }
  }
}
