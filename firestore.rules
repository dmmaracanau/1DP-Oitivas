rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sincronização de perfis e configurações de usuários entre múltiplos dispositivos
    match /users/{userId} {
      allow read, write: if true;
    }

    // Coleção principal de oitivas e agendamentos policiais
    match /oitivas/{oitivaId} {
      allow read, write: if true;
    }

    // Regra geral para todas as coleções do sistema
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

